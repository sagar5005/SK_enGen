# Copy to .env (git-ignored) or set as environment variables. Never commit real credentials.
# SQL authentication:
MSSQL_CONNECTION_STRING=Data Source=your-server,1433; Initial Catalog=eBS_Benefit_WYCFG; User Id=your-user; Password=your-password; Encrypt=True; TrustServerCertificate=False;
# Windows authentication (NTLM) instead: use Integrated Security=SSPI in the string above and set
# MSSQL_USERNAME, MSSQL_PASSWORD, MSSQL_DOMAIN.
# Leave unset to keep the server read-only. Only enables the execute_query tool (SELECT only).
# MSSQL_ENABLE_EXECUTE_QUERY=true
